+class WebPlayer:
+    """Feed the browser transcoder without opening a desktop window."""
+    def __init__(self, vps, sps, pps, *, web, on_stop, on_ready,
+                 on_frame=None, on_decode_error=None):
+        from pymobiledevice3.remote.core_device.hevc_av import remove_emulation_prevention, parse_sps
+        state = parse_sps(remove_emulation_prevention(sps[2:]))
+        self.width, self.height = state.pic_width_in_luma_samples, state.pic_height_in_luma_samples
+        self.web = web
+        self.web.feed(b''.join(b'\x00\x00\x00\x01'+n for n in (vps, sps, pps)))
+        on_ready(self)
+
+    def feed(self, data):
+        self.web.feed(data)
+
+    def close(self):
+        pass
